{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node20",
    "target": "es2023",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["hardhat.config.ts", "src/**/*.ts", "test/**/*.ts", "artifacts/**/*.d.ts"]
}
