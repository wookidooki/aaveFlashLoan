# Copy this file to .env and fill in what you need. NEVER share or commit .env.

# Which chains to watch (comma separated)
CHAINS=base,arbitrum

# Optional: your own RPC links (faster, fewer limits than the free public ones).
# Free accounts: alchemy.com or infura.io
# RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Scanner tuning
POLL_MS=500
MAX_HOPS=3
MIN_POOL_TVL_USD=25000
MIN_PROFIT_USD=0.5
TRADE_SIZES_USD=100,500,2000,10000,50000,200000

# ---- LIVE TRADING (off by default) ----
# Use a NEW wallet that holds only a little ETH for gas on each chain.
LIVE=false
# PRIVATE_KEY=0x...
# FLASH_ARB_BASE=0x...        (address printed by: npm run deploy -- base)
# FLASH_ARB_ARBITRUM=0x...    (address printed by: npm run deploy -- arbitrum)
MAX_GAS_USD_PER_TRADE=0.5
MAX_GAS_USD_PER_DAY=5
MAX_FAILS_IN_A_ROW=5
PAUSE_MIN_AFTER_FAILS=30
# Share of the expected profit paid as priority fee (tip), so the trade lands early in the block
TIP_PROFIT_SHARE=0.3
